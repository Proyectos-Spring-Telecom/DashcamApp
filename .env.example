# Copia este archivo a `.env` y rellena con tus valores reales.
# NUNCA subas `.env` a Git.
#
# Uso recomendado:
#   cp .env.development.example .env
#   flutter run --dart-define-from-file=.env
#
# Android: google_maps_flutter usa la clave nativa del AndroidManifest.
# Gradle la toma de GOOGLE_MAPS_API_KEY (env), google.maps.api.key en
# android/local.properties, o GOOGLE_MAPS_API_KEY en este .env (ver build.gradle).
#
# Plantillas por ambiente (solo ejemplos, sin secretos):
#   .env.development.example | .env.qa.example | .env.production.example

APP_ENV=development

# API Base URL (backend DashCamPay)
API_BASE_URL=https://dashcampay.com/apipay

# Opcional: solo si auth vive en otro host (por defecto = API_BASE_URL)
# AUTH_API_BASE_URL=https://dashcampay.com/apipay

# Google Maps (https://console.cloud.google.com/apis/credentials)
# Web: --dart-define-from-file=.env | Android: misma clave vía Gradle (build.gradle)
# Habilitar "Maps SDK for Android" y restringir por package com.trueuly.dashboardpro + SHA-1
GOOGLE_MAPS_API_KEY=

# NetPay - Llave pública para tokenización (pk_*). Nunca sk_* en el cliente.
NETPAY_PUBLIC_API_KEY=
