# Copiar a .env.production antes de builds de producción (no commitear).
# Uso:
#   flutter build web --release --dart-define-from-file=.env.production ...
#   flutter build apk --release --dart-define-from-file=.env.production
APP_ENV=production
API_BASE_URL=https://dashcampay.com/api
GOOGLE_MAPS_API_KEY=
NETPAY_PUBLIC_API_KEY=
